#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Grant least-privilege file caps so osslscope runs unprivileged.
# On any failure: warn with the labeled-sudo fallback, never fail install.
set -e
case "$1" in
  configure)
    if command -v setcap >/dev/null 2>&1; then
      if setcap cap_bpf,cap_perfmon+ep /usr/bin/osslscope 2>/dev/null; then
        :
      else
        echo "osslscope: setcap failed; fallback (labeled sudo): run 'sudo setcap cap_bpf,cap_perfmon+ep /usr/bin/osslscope' then 'osslscope doctor'." >&2
      fi
    else
      echo "osslscope: setcap not found (install libcap2-bin); fallback (labeled sudo): run 'sudo setcap cap_bpf,cap_perfmon+ep /usr/bin/osslscope' then 'osslscope doctor'." >&2
    fi
    # §1.4: the new unit must be startable right after install —
    # reload best-effort (never fail install). Install only: never
    # enable here (the admin enables after configuring targets).
    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    ;;
esac
exit 0
