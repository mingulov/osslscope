# D-record §1.4 frozen — changes need a §1.4 amendment (+ minor bump).
[Unit]
Description=osslscope continuous OpenSSL observer service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/osslscope service --config /etc/osslscope/service.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# +exit 2 to RestartPreventExitStatus: §1.4 Amendment A2
# (ratified) — stock config selects no targets → service refuses
# with exit 2 → without prevention the unit restart-loops 5×/300s
# then fails; exit 2 is config-refused (never a crash), so holding
# the unit stopped is correct.
RestartPreventExitStatus=2 4
StateDirectory=osslscope
# +CAP_SYS_PTRACE: §1.4 grants it iff foreign-uid targets are
# selected. The unit runs as root, so any non-root target is
# foreign — the shipped unit carries it. Drop it only when every
# target runs as root.
# +CAP_CHECKPOINT_RESTORE +CAP_DAC_READ_SEARCH: §1.4 Amendment A1
# (ratified) — required for foreign-identity verification; without
# them foreign members gap identity_unverified and attach finds
# zero sites.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_CHECKPOINT_RESTORE CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
